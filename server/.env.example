# Backend (Node/Express) environment variables — placeholders only, never commit real values.

# --- Server ---
# Local port — must match the Vite proxy target (client/vite.config.js → 127.0.0.1:5001).
# Cloud platforms inject PORT, which takes precedence (see server/config/serverConfig.js).
APP_PORT=5001
APP_SECRET=your-jwt-signing-secret
# CORS allowlist: FRONTEND_URL and CLIENT_URL are both accepted as canonical
# frontend origins. ALLOWED_ORIGINS adds optional extras, comma-separated
# (exact origins only — never a wildcard). Behaviour when NOTHING is configured:
#   - production/staging (NODE_ENV=production|staging): FAIL CLOSED — every
#     browser origin is denied and a clear error is logged. ALWAYS set an origin
#     for a deployment (the deployed Cloud Run client origin must be listed).
#   - development (any other NODE_ENV): an explicit localhost allowlist is used
#     (http://localhost:5173, http://127.0.0.1:5173, http://localhost:4173) —
#     never a wildcard.
# To open the app on another device over Wi-Fi, add that LAN origin here too
# (e.g. http://192.168.1.100:5173).
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Canonical frontend URL used for generated links (driver-pass, password-reset).
# In production set this to your HTTPS Cloud Run client URL.
FRONTEND_URL=http://localhost:5173

# Optional DEVELOPMENT-ONLY LAN URL for opening driver passes on another device
# (e.g. a phone on the same Wi-Fi — "localhost" there would point at the phone).
# When set (and NODE_ENV is not "production"), booking messages include BOTH a
# phone/Wi-Fi link and the laptop link. Find the address with `ipconfig` and use
# your Wi-Fi IPv4 (do NOT commit a real IP here — it changes between networks).
FRONTEND_NETWORK_URL=http://192.168.1.100:5173

# --- Reverse proxy & API rate limiting ---
# Number of trusted proxy hops in front of Express. Cloud Run = 1. This lets the
# rate limiter read the REAL client IP from X-Forwarded-For WITHOUT trusting
# arbitrary forwarded values (never set this so that all proxies are trusted).
TRUST_PROXY=1
# Route-aware rate limits. Key = authenticated user id when a Bearer token is
# present, else the client IP. Trusted internal AI-service calls (x-service-key)
# are never throttled. Windows are in ms; *_MAX is requests per window. Defaults
# below are polling-safe (see the security report's frequency analysis) — raise
# or lower per environment; omit a var to use the built-in default.
# Auth (login/register) — strict, per IP:
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
# Password reset (forgot-password) — strict, per IP:
RATE_LIMIT_RESET_WINDOW_MS=900000
RATE_LIMIT_RESET_MAX=5
# Public unauthenticated lookups (e.g. GET /api/bookings/:ref, driver pass):
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
# Public Cloud Run/monitoring liveness and readiness probes (combined, per IP):
RATE_LIMIT_HEALTH_WINDOW_MS=60000
RATE_LIMIT_HEALTH_MAX=120
# Authenticated reads + dashboard/alert polling (generous):
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=300
# Authenticated writes (create/update/delete):
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=120
# Uploads / image enrolment (expensive, low-frequency):
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=40
# AI proxy / high-frequency recognition + QR (GateScanner peaks ~300 req/min):
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=1200
# Public AI Helpdesk chat (unauthenticated, and now billed per Gemini call) — per IP:
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=20

# --- Google Gemini (Module 3 AI Helpdesk chat replies) ---
# Tenant-facing chat replies are generated by Gemini, grounded in the
# KnowledgeBase table. Escalation and ticket categorisation stay fully
# deterministic (see server/services/supportService.js) — Gemini only writes
# the reply text, and a missing key / API failure / timeout falls back to the
# existing keyword-matched answer, never a broken response.
# Get a key at https://aistudio.google.com/apikey — never commit a real value.
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.0-flash and other dated/pinned models may show a 0-quota free tier
# on newer API keys — gemini-flash-latest is the alias confirmed working, but
# it is a slower "thinking" model (observed 9-30s per reply on the free tier),
# hence the generous timeout below. Swap this once billing/a faster model is
# available if lower latency matters more than free-tier cost.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000

# --- Cloud SQL for PostgreSQL (local development may use any PostgreSQL host) ---
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PWD=your-db-password
# Schema changes are applied only through the reviewed SQL migrations below.
# Keep this false in staging/production; startup still validates live columns.
DB_SYNC_ALTER=false

# --- Python AI services ---
# FACE_AI_URL is the BASE url of the InsightFace service (ai-service/main.py).
# The backend appends paths to it: /api/encode-faces, /refresh, /user/recognize.
# Do NOT put a full endpoint path here.
FACE_AI_URL=http://127.0.0.1:8501
# PYTHON_AI_URL is a FULL endpoint url used by the (teammate-owned) incident scan route.
# It already includes /recognize — do not append another path.
PYTHON_AI_URL=http://127.0.0.1:8000/recognize

# --- Shared secret for server-to-server calls (both directions) ---
# 1) The ai-service sends this in an `x-service-key` header when POSTing detection
#    alerts, so it can create alerts without a user JWT.
# 2) The Node backend sends the SAME key in an `X-AI-Service-Key` header when calling
#    the FastAPI face endpoints (/api/encode-faces, /user/recognize, /refresh).
# Must match ai-service/.env's AI_SERVICE_KEY. For local dev you may use a simple
# value like "dev-local-ai-key" — never commit or deploy a real secret here.
AI_SERVICE_KEY=your-shared-ai-service-secret

# --- Trusted edge-device token (optional) ---
# A future Pi edge node may call POST /api/facial-recognition/recognize directly by
# sending this value in an `x-edge-token` header instead of an FM user JWT.
# Leave unset to disable the edge-token path entirely.
EDGE_SERVICE_TOKEN=your-edge-device-token
# --- Edge hardware ingest (Raspberry Pi SecurePi -> Node backend) ---
# SecurePi posts to POST /api/edge/detection-alerts with:
#   Authorization: Bearer <EDGE_INGEST_TOKEN>
# Keep this separate from user JWT auth and AI_SERVICE_KEY.
EDGE_INGEST_TOKEN=dev-securepi-token

# --- Detection snapshot storage (optional, temporary) ---
# Empty/unset uses the operating-system temporary directory. On Cloud Run this
# resolves to /tmp/flowguard/detection-snapshots, which is instance-local and
# ephemeral: snapshots can disappear after a restart or when another instance
# serves a later request. A custom directory must already be writable by the
# non-root runtime user. Never point this at /app/uploads.
DETECTION_SNAPSHOT_DIR=

# --- Google reCAPTCHA (server-side secret) ---
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# --- Password-reset email through Gmail/Nodemailer (SERVER-SIDE ONLY) ---
# SMTP_PASS must be a Google App Password, NOT the normal Gmail password.
# Gmail 2-Step Verification must be enabled on the account before Google will
# let you generate an App Password (Google Account → Security → App Passwords).
# Real SMTP values belong ONLY in server/.env or your cloud provider's
# environment variables — NEVER in client/.env or any VITE_ variable (every
# VITE_ value is shipped to the browser).
# Port 587 uses STARTTLS, so SMTP_SECURE stays false (true is for port 465).
# Leave SMTP_* unset in local development to simulate sends: the reset link is
# printed to the server console instead of being emailed (dev only — production
# never prints reset links).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=flowguard-example@gmail.com
SMTP_PASS=replace-with-google-app-password
MAIL_FROM="FlowGuard <flowguard-example@gmail.com>"

# Frontend used to generate reset-password links:
# the emailed link is ${CLIENT_URL}/reset-password?token=...
# CLIENT_URL is already defined in the CORS section near the top of this file —
# do not add a second copy; point it at your frontend (http://localhost:5173
# locally, your deployed frontend URL in production).

# --- Loading-bay gate verification (Smart Logistics) ---
# Arrival grace window for automatic/manual gate ENTRY, in minutes. A Confirmed
# booking with a slot may arrive from (slot_start - GATE_EARLY_MINUTES) up to
# (slot_end + GATE_LATE_MINUTES); outside that it is denied TOO_EARLY / TOO_LATE.
# Bookings with no slot are allowed with a "schedule unverified" warning.
GATE_EARLY_MINUTES=30
GATE_LATE_MINUTES=60

# --- WhatsApp / driver notifications (Smart Logistics) ---
# Leave WHATSAPP_ENABLED=false for local/demo: the service then simulates sends and
# never calls the real API. Set it to "true" ONLY with real credentials to send live.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here   # preferred bearer token — never commit the real value
WHATSAPP_API_KEY=your_whatsapp_access_token_here        # fallback token (used if ACCESS_TOKEN is unset)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# --- WhatsApp / SECURITY detection alerts (SecurePi / IMX500 / PIR edge events) ---
# A SEPARATE message family from the driver/booking notifications above. These go
# to FM/security staff, NEVER to a driver phone, and carry no booking details.
#   WHATSAPP_DETECTION_ALERTS_ENABLED  master switch for edge detection alerts.
#       Even when "true", nothing is sent unless recipients are configured below.
#   WHATSAPP_ENABLED still governs mock vs real: false = simulated send (safe demo).
#   WHATSAPP_SECURITY_RECIPIENTS  comma-separated SG numbers; normalized + de-duped.
#       Bare 8-digit locals get a 65 prefix. NEVER commit real numbers.
#   WHATSAPP_DETECTION_MIN_SEVERITY  Low < Medium < High < Critical — alerts below
#       this floor are saved but not WhatsApp'd (status "Skipped"). Default Low.
WHATSAPP_DETECTION_ALERTS_ENABLED=false
WHATSAPP_SECURITY_RECIPIENTS=6591234567,6598765432
WHATSAPP_DETECTION_MIN_SEVERITY=Low
