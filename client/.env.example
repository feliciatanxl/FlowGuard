# Frontend (Vite) environment variables — placeholders only, never commit real values.
# All client-side vars MUST be prefixed with VITE_ to be exposed to the browser.

# Google reCAPTCHA site key (public key, used on register/login forms)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Node backend base URL — the ONE canonical API-base variable for the whole app
# (facial recognition, attendance, security logs, Smart Logistics, Driver Pass).
# Leave EMPTY for local dev (relative /api URLs use the Vite proxy) and for the
# current Cloud Run client image (same-origin Nginx proxies /api and /user to Node).
# Use an explicit Node URL only in an alternate host without that reverse proxy.
# The frontend must NEVER call the private FastAPI AI service directly.
# PUBLIC value only — never place secret keys in any VITE_ variable.
VITE_API_BASE_URL=https://your-node-backend.example.com

# Raspberry Pi Camera Module 3 — primary gate camera node (Gate Scanner /
# V-Patrol / Face Enrolment / Smart Logistics QR). Point these at the Pi's MJPEG
# stream and snapshot endpoints on your trusted demo network. Runtime setup in
# Settings is preferred for hotspot addresses because it requires no rebuild.
# Chrome requires the user to grant local-network access to the deployed HTTPS
# frontend before it can contact a local HTTP device.
VITE_PI_CAMERA_HEALTH_URL=http://your-pi-address:8081/health
VITE_PI_CAMERA_STREAM_URL=http://your-pi-address:8081/video_feed
VITE_PI_CAMERA_SNAPSHOT_URL=http://your-pi-address:8081/snapshot

# Optional camera-source flags (all safe to leave unset — sensible defaults):
#   VITE_ENABLE_PI_CAMERA=false      — force-disable the Pi source even if a URL
#                                      above leaked into the build (cloud safety).
#   VITE_ENABLE_CLOUD_QR_FALLBACK=false — disable the cloud OpenCV snapshot QR
#                                      fallback (local BarcodeDetector/ZXing +
#                                      manual entry still work).
#   VITE_QR_CLOUD_FALLBACK_DELAY_MS=2500 — ms of local-only scanning before the
#                                      cloud snapshot fallback activates.
#   VITE_CAMERA_DEBUG=true           — show the small QR timing/diagnostic panel.
VITE_ENABLE_PI_CAMERA=true
VITE_ENABLE_CLOUD_QR_FALLBACK=true
VITE_QR_CLOUD_FALLBACK_DELAY_MS=2500
VITE_CAMERA_DEBUG=false

# Facial Gate Scanner / V-Patrol recognition capture. Defaults preserve the
# embedding accuracy established by current testing; only 512-640 px and
# JPEG quality 0.74-0.85 are accepted. Invalid values fall back to defaults.
VITE_FACE_CAPTURE_MAX_WIDTH=512
VITE_FACE_CAPTURE_JPEG_QUALITY=0.74

# Optional Raspberry Pi SecurePi MJPEG stream for local PoC / hotspot testing.
# Set these in client/.env.local using the Pi IP from `hostname -I`.
VITE_SECUREPI_STREAM_URL=http://<raspberry-pi-ip>:8001/video_feed
VITE_SECUREPI_HEALTH_URL=http://<raspberry-pi-ip>:8001/health

