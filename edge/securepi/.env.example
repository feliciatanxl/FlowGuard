FLOWGUARD_API_BASE_URL=http://172.20.10.2:5001
FLOWGUARD_ALERT_ENDPOINT=/api/edge/detection-alerts
EDGE_INGEST_TOKEN=dev-securepi-token
FLOWGUARD_DEVICE_ID=securepi-loading-bay-01
# With FLOWGUARD_API_BASE_URL + FLOWGUARD_ZONE_NAME both set, securePi.py polls
# GET {FLOWGUARD_API_BASE_URL}/api/edge/zone-config?zone_name=<name> every 60s and
# applies that zone's Detection Setup rule (unattended threshold, crowd/density
# threshold, alert cooldown, monitored classes, severity) on top of the values
# below — so changes made on the Zones page take effect without touching this file.
# A failed/offline fetch just logs a warning and keeps using the local values here.
FLOWGUARD_ZONE_NAME=Loading Bay
FLOWGUARD_ZONE_CONFIG_ENDPOINT=/api/edge/zone-config
FLOWGUARD_CAMERA_LOCATION=Loading Bay Camera 01
STREAM_ENABLED=true
STREAM_HOST=0.0.0.0
STREAM_PORT=8001
STREAM_FPS=8
STREAM_JPEG_QUALITY=70
APP_HOST=0.0.0.0
APP_PORT=5001

SECUREPI_MODE=imx500
IMX500_MODEL_PATH=/home/pi/models/object_detection.rpk
UNATTENDED_TIME=60
PROXIMITY_PX=150
ALERT_COOLDOWN=30
CROWD_THRESHOLD=1
SNAPSHOT_DIR=alerts/loading-bay
SECUREPI_SEVERITY=High
HEADLESS=true
POLL_SECONDS=0.2
