# Python AI service environment variables — placeholders only, never commit real values.
# The service reads the same PostgreSQL credentials as the backend to load face embeddings.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PWD=your-db-password

# Shared secret used in BOTH directions:
# 1) sent as the `x-service-key` header when POSTing detection alerts to the Node
#    backend (see _fire_alert in main.py);
# 2) required (as `X-AI-Service-Key`) on all inbound face, tracking, QR and YOLO
#    processing endpoints — only the Node backend may call them. If unset, the
#    check is skipped (LOCAL DEV ONLY — never deploy
#    without it). Must match server/.env's AI_SERVICE_KEY.
# For local dev you may use a simple value like "dev-local-ai-key".
AI_SERVICE_KEY=your-shared-ai-service-secret

# Browser origins allowed by CORS (comma-separated). AI endpoints are called by
# the Node backend (no CORS needed); the frontend does not call YOLO directly.
# Keep this as an explicit allowlist; never use a wildcard with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Node backend base URL used when the AI service posts detection alerts. In
# Cloud Run this must be the deployed HTTPS Node service URL, never localhost.
NODE_SERVER_URL=http://localhost:5001

# Cloud Run has no attached webcam. Keep false there so startup and /health do
# not require camera hardware; browser-captured frames remain supported.
USE_SERVER_CAMERA=false

# Fallback "applied_threshold_seconds" (in seconds) used only when a requested
# camera/zone can't be resolved to a Detection Setup rule (see zone_rules.py). Optional
# — falls back to 300 (5 minutes) if unset or not a positive integer.
DEFAULT_ZONE_THRESHOLD_SEC=300

# Cloud QR snapshot decoder (POST /api/qr/decode) limits — optional, sane defaults.
#   QR_MAX_IMAGE_BYTES     — max decoded image size accepted (default 6 MiB).
#   QR_ALLOWED_CONTENT_TYPES — comma-separated data-URL mime allowlist.
# The endpoint returns a CANDIDATE booking reference only; it never verifies a
# booking, grants access, or writes any record (the Node gate route is authoritative).
QR_MAX_IMAGE_BYTES=6291456
QR_ALLOWED_CONTENT_TYPES=image/jpeg,image/jpg,image/png
